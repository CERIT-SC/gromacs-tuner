#!/bin/bash
# GROMACS wrapper script with scratch directory support
# Handles file synchronization between PVC and scratch for performance

WORKDIR="$PWD"

# Detect double precision mode from binary name
if [ -z "$GMX_DOUBLE" ]; then
    GMX_DOUBLE=OFF
    b=$(basename "$0")
    [ "$b" = gmx_d ] || [ "$b" = mdrun_d ] && GMX_DOUBLE=ON
    export GMX_DOUBLE
fi

# Select appropriate GROMACS binary based on CPU
source /gromacs/gmx-chooser.sh

# Copy necessary files from PVC to scratch directory
copy() {
    # Copy HILLS and COLVAR files if present (for PLUMED)
    cp HILLS COLVAR "$SCRATCHDIR" 2>/dev/null || true

    # Copy files specified in arguments
    while test $# -gt 0; do
        case "$1" in
            -deffnm*)
                shift
                cp "$1"* "$SCRATCHDIR" 2>/dev/null || true
                shift
                ;;
            *)
                if [ -f "$1" ]; then
                    cp "$1" "$SCRATCHDIR"
                fi
                shift
                ;;
        esac
    done
}

# Synchronize scratch directory back to PVC
sync() {
    rsync -aq "$SCRATCHDIR"/* "$WORKDIR" 2>/dev/null || true
}

stop_sync() {
    if [ -n "$sync_pid" ]; then
        kill "$sync_pid" 2>/dev/null || true
        wait "$sync_pid" 2>/dev/null || true
        sync
    fi
}

# Ensure final sync on exit
trap stop_sync EXIT

# Set up scratch directory if defined
if [ -n "$SCRATCHDIR" ]; then
    touch "$SCRATCHDIR"/x || exit 1
    rm -f "$SCRATCHDIR"/x
    copy "$@"
    cd "$SCRATCHDIR" || exit 1

    # Background sync every 60 seconds
    while true; do
        sleep 60
        sync
    done &
    sync_pid=$!
fi

# Execute GROMACS command
if [ "$(basename "$0" _d)" = mdrun ]; then
    gmx mdrun "$@"
else
    gmx "$@"
fi
